<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0-windows;net48</TargetFrameworks>
    <RootNamespace>ExcelFormulaLabs.Analytics</RootNamespace>
    <AssemblyName>Analytics</AssemblyName>
    <Description>统计 · 线性代数 · 回归 · 物理化学 · 实验设计与分析 — 92 个科学计算函数</Description>
    <Product>Excel 函数增强库</Product>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>CS1591;CS8625;NU1701</NoWarn>
    <ExcelAddInFileName Condition="'$(TargetFramework)' == 'net48'">Analytics-AddIn-net48</ExcelAddInFileName>
    <ExcelAddInFileName Condition="'$(TargetFramework)' == 'net8.0-windows'">Analytics-AddIn-net8.0</ExcelAddInFileName>
    <ExcelDna64BitAddInSuffix>-64</ExcelDna64BitAddInSuffix>
    <!-- P1-3 (pre-release review): serialise inner TFM builds — shared generated .dna file
         raced under parallel inner builds (net8.0 xll observed inside net48 publish dir). -->
    <BuildInParallel>false</BuildInParallel>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Analytics.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>DataToolkit.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>CrossValRunner</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>ExcelFormulaLabs.Benchmarks</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
    <PackageReference Include="ExcelDna.Integration" Version="1.9.0" />
    <PackageReference Include="ExcelDna.AddIn" Version="1.9.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="ExcelDna.IntelliSense" Version="1.9.0" Condition="'$(TargetFramework)' == 'net48'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Foundation\Foundation.csproj" />
  </ItemGroup>

  <!--
    Analytics.xll — Statistics, Regression, Linear Algebra, PhyChem.
    Targets net8.0-windows + net48. Depends on Foundation.dll + MathNet.Numerics.
    Uses Excel-DNA for .xll packaging and UDF registration.
  -->

  <!-- Exclude IntelliSense from net8.0 build per agents.md IntelliSense 框架隔离 rule.
       Excel-DNA auto-discovers dependencies via deps.json; without this the DLL
       would be packed into the net8.0 .xll even though the .dna.tpl omits it. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <ExcelDnaPackExcludeDependencies>ExcelDna.IntelliSense.dll</ExcelDnaPackExcludeDependencies>
  </PropertyGroup>

  <!-- Generate correct .dna from templates per target before ExcelDnaBuild,
       then clean up afterward. The generated DNA file is shared across inner
       builds; a stale file on disk can poison incremental builds.
       Wildcard-delete every ExcelDnaBuild-generated .dna so that 32/64-bit
       variants from the opposite TFM inner build never leak across. -->
  <Target Name="GenerateDnaFromTemplate" BeforeTargets="ExcelDnaBuild">
    <!-- review 2026-08-31（深度审查 P1-9）：原通配删除 Analytics-AddIn*.dna 在双 TFM 并行内建下
         互相踩踏（net48 的 Delete 删掉 net8.0 刚 Copy 的 .dna → DNA3414/MSB3491 间歇性失败，
         本地 50% 失败率，CI 主 build job 同样暴露）。改为每个 TFM 只删除/生成自己的 .dna。 -->
    <ItemGroup>
      <_StaleDna Condition="'$(TargetFramework)' == 'net48'" Include="Analytics-AddIn-net48.dna" />
      <_StaleDna Condition="'$(TargetFramework)' == 'net8.0-windows'" Include="Analytics-AddIn-net8.0.dna" />
    </ItemGroup>
    <Delete Files="@(_StaleDna)" />
    <Copy Condition="'$(TargetFramework)' == 'net8.0-windows'"
          SourceFiles="Analytics-AddIn-net8.dna.tpl"
          DestinationFiles="Analytics-AddIn-net8.0.dna" />
    <Copy Condition="'$(TargetFramework)' == 'net48'"
          SourceFiles="Analytics-AddIn-net48.dna.tpl"
          DestinationFiles="Analytics-AddIn-net48.dna" />
  </Target>
  <Target Name="CleanupDnaAfterBuild" AfterTargets="ExcelDnaPack">
    <ItemGroup>
      <_GenDna Condition="'$(TargetFramework)' == 'net48'" Include="Analytics-AddIn-net48.dna" />
      <_GenDna Condition="'$(TargetFramework)' == 'net8.0-windows'" Include="Analytics-AddIn-net8.0.dna" />
    </ItemGroup>
    <Delete Files="@(_GenDna)" />
  </Target>

  <!-- Patch VERSIONINFO in packed .xll files so Excel add-in manager
       shows meaningful descriptions instead of Excel-DNA defaults. -->
  <Target Name="PatchXllVersionInfo" AfterTargets="ExcelDnaPack" Condition="'$(Configuration)' == 'Release'">
    <Exec Condition="'$(TargetFramework)' == 'net48'" Command="powershell -NoProfile -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\patch-xll-version.ps1&quot; -XllPath &quot;$(OutDir)publish\Analytics-AddIn-net48-packed.xll&quot; -FileDescription &quot;$(Description)&quot; -ProductName &quot;$(Product)&quot;" />
    <Exec Condition="'$(TargetFramework)' == 'net48'" Command="powershell -NoProfile -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\patch-xll-version.ps1&quot; -XllPath &quot;$(OutDir)publish\Analytics-AddIn-net48-64-packed.xll&quot; -FileDescription &quot;$(Description)&quot; -ProductName &quot;$(Product)&quot;" />
    <Exec Condition="'$(TargetFramework)' == 'net8.0-windows'" Command="powershell -NoProfile -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\patch-xll-version.ps1&quot; -XllPath &quot;$(OutDir)publish\Analytics-AddIn-net8.0-packed.xll&quot; -FileDescription &quot;$(Description)&quot; -ProductName &quot;$(Product)&quot;" />
    <Exec Condition="'$(TargetFramework)' == 'net8.0-windows'" Command="powershell -NoProfile -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\patch-xll-version.ps1&quot; -XllPath &quot;$(OutDir)publish\Analytics-AddIn-net8.0-64-packed.xll&quot; -FileDescription &quot;$(Description)&quot; -ProductName &quot;$(Product)&quot;" />
  </Target>

  <!-- 打包后验证：检查 .xll 产物完整性 -->
  <Target Name="VerifyPackOutput" AfterTargets="ExcelDnaPack"
          Condition="'$(Configuration)' == 'Release'">
    <Message Text="[VerifyPack] Analytics $(TargetFramework) — 检查打包产物..." Importance="high" />
    <Exec Command="powershell -NoProfile -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\verify-pack.ps1&quot; -PublishDir &quot;$(OutDir)publish&quot; -Module Analytics -Tfm &quot;$(TargetFramework)&quot;">
      <Output TaskParameter="ExitCode" PropertyName="_VerifyExitCode" />
    </Exec>
    <!-- review-2026-08-29 P2-10：验证失败改 Error（原 Warning + ContinueOnError 会让坏产物照常发布） -->
    <Error Text="[VerifyPack] 验证发现问题，请检查上述输出。" Condition="$(_VerifyExitCode) != 0" />
  </Target>

</Project>