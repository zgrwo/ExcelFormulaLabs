<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net48</TargetFrameworks>
    <RootNamespace>ExcelFormulaLabs.Foundation</RootNamespace>
    <AssemblyName>Foundation</AssemblyName>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- NuGet package metadata -->
    <IsPackable>true</IsPackable>
    <PackageId>ExcelFormulaLabs.Foundation</PackageId>
    <Description>Shared foundation library for ExcelFormulaLabs: InputNormalizer, ElementWiseMapper (MapOver), OutputWrapper, ArrayOperations, FilterUtils, ExceptionFilters.</Description>
    <PackageTags>excel;udf;formula;foundation;excel-dna</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
  </ItemGroup>

  <!--
    Foundation.dll — zero NuGet dependencies. Targets net8.0 + net48.
    Provides InputNormalizer, ElementWiseMapper, OutputWrapper,
    ArrayOperations, DictOperations, ComparisonUtils, FilterUtils.
    Referenced by Analytics.dll and DataToolkit.dll (Excel-DNA host assemblies).
  -->

  <ItemGroup>
    <InternalsVisibleTo Include="Foundation.Tests" />
    <InternalsVisibleTo Include="CrossValRunner" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="ErrorMessages.resx">
      <LogicalName>ExcelFormulaLabs.Foundation.ErrorMessages.resources</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
